{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug React Client (Chrome)",
      "url": "http://localhost:5173/ExamApp-MockData/",
      "webRoot": "${workspaceFolder}/client",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/src/*",
        "/src/*": "${webRoot}/src/*"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Express Server",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/server/index.js",
      "console": "integratedTerminal"
    },
    {
        "name": "Attach",

        "type": "node",

        "request": "attach",

        "port": 9229
    },
    {
      "name": "Attach: Docker Server",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "localRoot": "${workspaceFolder}/server",
      "remoteRoot": "/app",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "name": "Attach: Docker AI Worker",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9230,
      "localRoot": "${workspaceFolder}/services/ai-worker",
      "remoteRoot": "/app",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack (Server + Client)",
      "configurations": [
        "Debug Express Server",
        "Debug React Client (Chrome)"
      ]
    },
    {
      "name": "Debug Exam App Backend",
      "configurations": [
        "Attach: Docker Server",
        "Attach: Docker AI Worker"
      ],
      "stopAll": true
    }
  ]
}
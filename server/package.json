{
  "name": "server",
  "version": "1.0.0",
  "description": "Express server for ExamApp",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --config nodemon.json server.js",
    "start:e2e": "node server.js",
    "test-db": "node scripts/testDbConnection.js",
    "db:migrate": "node database/migrate.js",
    "db:seed-users": "node scripts/seedUsers.js",
    "db:seed-exams": "node scripts/seedExams.js",
    "db:seed-submissions": "node scripts/seedSubmissions.js",
    "db:seed-notifications": "node scripts/seedNotifications.js",
    "test-exams": "node scripts/testExamRepository.js",
    "test-submissions": "node scripts/testSubmissionRepository.js",
    "test-notifications": "node scripts/testNotificationRepository.js",
    "test-documents": "node scripts/testDocumentRepository.js",
    "cleanup:mcp": "node scripts/cleanupMcpSecurity.js",
    "test:mcp-confirmations": "node --test tests/mcpConfirmationTools.test.js",
    "db:migrate:test": "node database/migrateTest.js",
    "test:ci": "npm run db:migrate:test && npm run test:mcp-confirmations",
    "test:conversations": "node --test tests/conversationCrud.test.js",
    "test:submission-permissions": "node --test tests/submissionPermissions.test.js",
    "test:student-exam-security": "node --test tests/studentExamSecurity.test.js",
    "test:student-review": "node --test tests/studentSubmissionReview.test.js",
    "test:exam-password": "node --test tests/examPasswordSecurity.test.js",
    "test:duplicate-submission": "node --test tests/duplicateSubmission.test.js",
    "test:integration": "node --test tests/*.test.js",
    "init-db": "node scripts/initDb.js",
    "seed-db": "node scripts/seedDb.js",
    "get-exam": "node testGetExam.js",
    "test-queries": "node testQueries.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
